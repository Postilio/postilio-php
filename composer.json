{
  "name": "postilio/postilio-php",
  "description": "The official PHP client for the Postilio API: European transactional email.",
  "type": "library",
  "license": "MIT",
  "keywords": ["postilio", "email", "transactional", "api", "webhooks", "psr-18"],
  "homepage": "https://postilio.eu",
  "support": {
    "docs": "https://docs.postilio.eu",
    "source": "https://github.com/Postilio/postilio-php",
    "issues": "https://github.com/Postilio/postilio-php/issues",
    "security": "https://github.com/Postilio/postilio-php/security/policy"
  },
  "require": {
    "php": ">=8.2",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "infection/infection": "^0.29 || ^0.30 || ^0.31",
    "nyholm/psr7": "^1.8",
    "php-http/discovery": "^1.20",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "suggest": {
    "ext-curl": "For the built-in transport, when you pass no PSR-18 client",
    "php-http/discovery": "To find PSR-17 factories when you pass a PSR-18 client without them"
  },
  "autoload": {
    "psr-4": {
      "Postilio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Postilio\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true,
      "php-http/discovery": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix",
    "mutation": "infection --threads=max --initial-tests-php-options='-d pcov.enabled=1'"
  },
  "scripts-descriptions": {
    "test": "Run the unit and spec tests (the contract tests run when POSTILIO_CONTRACT_* is set)",
    "stan": "Static analysis at the highest level",
    "cs": "Check the code style (PER-CS)",
    "cs:fix": "Fix the code style",
    "mutation": "Mutation testing of the client's logic"
  }
}
